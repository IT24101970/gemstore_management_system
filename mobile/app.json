{
  "expo": {
    "name": "Ceylon Gems",
    "slug": "ceylon-gems-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ceylongemsmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}